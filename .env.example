# Client-safe application + Supabase Auth connection.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side database provider.
#
# Keep "supabase" until the Phase 04 Neon target has passed migration,
# tenant-isolation, and API certification.
TINDIO_DATABASE_PROVIDER=supabase

# Required only when TINDIO_DATABASE_PROVIDER=neon.
# This is the branch-scoped PostgREST-compatible Neon Data API base URL.
NEON_DATA_API_URL=

# Migration/admin connection only.
# NEVER expose this through NEXT_PUBLIC_*.
# Use the direct/unpooled Neon connection for schema migrations,
# pg_dump/pg_restore, and certification.
DATABASE_URL_UNPOOLED=

# Phase 04 remote source migration only.
# Never commit the real value.
TINDIO_SOURCE_DATABASE_URL=

# Explicit destructive/cutover guard.
TINDIO_PHASE_04_ALLOW_CUTOVER=NO

# Optional Phase 04 API certification account.
# Use a disposable PREPRODUCTION account with real TINDIO membership.
TINDIO_PHASE_04_TEST_EMAIL=
TINDIO_PHASE_04_TEST_PASSWORD=
