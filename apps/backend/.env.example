# Backend-owned read path (default). Supabase remains the current Auth issuer;
# all database reads are sent to the external-JWT-enabled Neon Data API.
TINDIO_BOOTSTRAP_READ_MODE=owned
TINDIO_REFERENCE_READ_MODE=owned
TINDIO_CATALOG_READ_MODE=owned
TINDIO_MODIFIERS_READ_MODE=owned
TINDIO_CUSTOMERS_READ_MODE=owned
TINDIO_RECEIPTS_READ_MODE=owned
TINDIO_RECEIPT_DETAIL_READ_MODE=owned
TINDIO_ATTENDANCE_EMPLOYEES_READ_MODE=owned
TINDIO_LIVE_READ_MODE=owned
TINDIO_CUSTOMER_DISPLAY_UPDATE_MODE=owned
TINDIO_FAVORITE_TILE_UPDATE_MODE=owned
TINDIO_CUSTOMER_CREATION_MODE=owned
TINDIO_OPEN_TICKET_SAVE_MODE=owned
TINDIO_OPEN_TICKET_CANCEL_MODE=owned
TINDIO_OPEN_TICKET_MOVE_LINES_MODE=owned
TINDIO_OPEN_TICKET_SPLIT_MODE=owned
TINDIO_OPEN_TICKET_MERGE_MODE=owned
TINDIO_CHECKOUT_MODE=owned
TINDIO_OFFLINE_CHECKOUT_MODE=owned
TINDIO_SYNC_PUSH_MODE=owned
TINDIO_REFUND_MODE=owned
TINDIO_TRANSFER_RECEIPT_MODE=owned
TINDIO_ATTENDANCE_MUTATION_MODE=owned
TINDIO_SALE_EXCHANGE_MODE=owned
TINDIO_RECEIPT_SETTINGS_MODE=owned
TINDIO_RECEIPT_DELIVERY_MODE=owned
TINDIO_DEVICE_SYNC_MODE=owned
SUPABASE_URL=https://project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
NEON_DATA_API_URL=https://data-api.example.neon.tech/rest/v1

# Emergency rollback only: set a route's TINDIO_*_READ_MODE or mutation
# TINDIO_*_UPDATE_MODE / TINDIO_*_SAVE_MODE to proxy and provide
# the existing Web deployment origin. Every proxy rejects routing loops.
TINDIO_WEB_API_ORIGIN=https://web.example.com
