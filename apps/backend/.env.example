# Backend-owned read path (default). Supabase remains the current Auth issuer;
# all database reads are sent to the external-JWT-enabled Neon Data API.
TINDIO_BOOTSTRAP_READ_MODE=owned
TINDIO_REFERENCE_READ_MODE=owned
TINDIO_CATALOG_READ_MODE=owned
TINDIO_MODIFIERS_READ_MODE=owned
TINDIO_CUSTOMERS_READ_MODE=owned
TINDIO_RECEIPTS_READ_MODE=owned
TINDIO_RECEIPT_DETAIL_READ_MODE=owned
TINDIO_ATTENDANCE_EMPLOYEES_READ_MODE=owned
TINDIO_LIVE_READ_MODE=owned
TINDIO_CUSTOMER_DISPLAY_UPDATE_MODE=owned
SUPABASE_URL=https://project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
NEON_DATA_API_URL=https://data-api.example.neon.tech/rest/v1

# Emergency rollback only: set a route's TINDIO_*_READ_MODE or the customer
# display TINDIO_*_UPDATE_MODE to proxy and provide
# the existing Web deployment origin. Every proxy rejects routing loops.
TINDIO_WEB_API_ORIGIN=https://web.example.com
